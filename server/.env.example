# 众爱联盟 - Charity Points Platform
# Environment Variables

# JWT Secret (generate with: openssl rand -base64 32)
NUXT_JWT_SECRET=your-jwt-secret-here

# WeChat Mini Program
NUXT_WECHAT_APP_ID=your-wechat-app-id
NUXT_WECHAT_APP_SECRET=your-wechat-app-secret

# ID Card Encryption Key (generate with: openssl rand -hex 16)
NUXT_ID_CARD_ENCRYPTION_KEY=your-encryption-key-here

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zhongai_alliance

# Server
PORT=3000
