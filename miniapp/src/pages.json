{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": { "navigationBarTitleText": "众爱联盟" }
    },
    {
      "path": "pages/activity/list",
      "style": { "navigationBarTitleText": "公益活动" }
    },
    {
      "path": "pages/activity/detail",
      "style": { "navigationBarTitleText": "活动详情" }
    },
    {
      "path": "pages/donation/submit",
      "style": { "navigationBarTitleText": "提交捐助" }
    },
    {
      "path": "pages/donation/list",
      "style": { "navigationBarTitleText": "我的捐助" }
    },
    {
      "path": "pages/points/index",
      "style": { "navigationBarTitleText": "我的积分" }
    },
    {
      "path": "pages/user/index",
      "style": { "navigationBarTitleText": "个人中心" }
    },
    {
      "path": "pages/user/profile",
      "style": { "navigationBarTitleText": "个人资料" }
    },
    {
      "path": "pages/user/realname",
      "style": { "navigationBarTitleText": "实名认证" }
    },
    {
      "path": "pages/login/index",
      "style": { "navigationBarTitleText": "登录", "navigationStyle": "custom" }
    },
    {
      "path": "pages/market/index",
      "style": { "navigationBarTitleText": "爱心集市" }
    },
    {
      "path": "pages/market/detail",
      "style": { "navigationBarTitleText": "帖子详情" }
    },
    {
      "path": "pages/market/create",
      "style": { "navigationBarTitleText": "发布帖子" }
    },
    {
      "path": "pages/market/my-posts",
      "style": { "navigationBarTitleText": "我的帖子" }
    },
    {
      "path": "pages/market/favorites",
      "style": { "navigationBarTitleText": "我的收藏" }
    },
    {
      "path": "pages/ranking/index",
      "style": { "navigationBarTitleText": "积分排行", "enablePullDownRefresh": true }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "众爱联盟",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#f5f5f5"
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#e54d42",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/tab/home.png",
        "selectedIconPath": "static/tab/home-active.png"
      },
      {
        "pagePath": "pages/activity/list",
        "text": "活动",
        "iconPath": "static/tab/activity.png",
        "selectedIconPath": "static/tab/activity-active.png"
      },
      {
        "pagePath": "pages/market/index",
        "text": "集市",
        "iconPath": "static/tab/market.png",
        "selectedIconPath": "static/tab/market-active.png"
      },
      {
        "pagePath": "pages/user/index",
        "text": "我的",
        "iconPath": "static/tab/user.png",
        "selectedIconPath": "static/tab/user-active.png"
      }
    ]
  }
}
