# 众爱联盟 Docker Deployment Environment Variables
# Copy to .env and fill in real values before running docker-compose up

# Database
DB_PASSWORD=your-strong-db-password

# JWT Secret (generate: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret

# WeChat Mini Program
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret

# ID Card Encryption Key (generate: openssl rand -hex 16)
ID_CARD_ENCRYPTION_KEY=your-encryption-key

# Frontend API base URL
VITE_API_BASE_URL=https://za.shone.xin
